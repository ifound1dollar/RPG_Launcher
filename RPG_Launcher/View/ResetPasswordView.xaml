<UserControl x:Class="RPG_Launcher.View.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             KeyDown="Universal_KeyDown"
             d:DataContext="{d:DesignInstance Type=vm:ResetPasswordViewModel}">
    
    <Grid Name="ResetPasswordSubgrid">

        <StackPanel Width="250px"
                        Orientation="Vertical"
                        Margin="0,120,0,130"
                        Grid.Row="1">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#001b1448" Offset="-0.5"/>
                    <GradientStop Color="#1b1424" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <Image Source="/Images/logo.png"
                       Width="80" Height="80"
                       Margin="0,25,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="Reset Password"
                       Foreground="AliceBlue"
                       FontSize="20"
                       FontFamily="Segoe UI Semibold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>

            <!-- Target user title. -->
            <TextBlock Text="Reset password for user: "
                       Foreground="LightBlue"
                       FontSize="14"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="10,15,10,0"/>
            <TextBlock Text="{Binding TargetUser, Mode=TwoWay}"
                       Foreground="LightBlue"
                       FontSize="16"
                       FontFamily="Segoe UI Black"
                       Margin="10,0,10,0"
                       HorizontalAlignment="Center"/>
            
            <!-- Password header and text box. Breaks MVVM pattern for security. -->
            <TextBlock Text="New Password"
                        Foreground="LightSlateGray"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="Left"
                        Margin="20,19,0,0"/>
            <PasswordBox Name="TextBoxPassword"
                        Height="24"
                        VerticalContentAlignment="Center"
                        Foreground="LightGray"
                        Background="#33000000"
                        FontSize="16"
                        FontFamily="Segoe UI Semibold"
                        CaretBrush="LightSlateGray"
                        BorderBrush="SlateGray"
                        BorderThickness="0,0,0,0"
                        Margin="18,2,18,0"
                        Padding="5,2,5,2"
                        PasswordChanged="TextBoxPassword_PasswordChanged">
            </PasswordBox>

            <!-- Confirm password header and text box. Breaks MVVM pattern for security. -->
            <TextBlock Text="Confirm Password"
                       Foreground="LightSlateGray"
                       FontSize="15"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Left"
                       Margin="20,5,0,0"/>
            <PasswordBox Name="TextBoxConfirmPassword"
                         Height="24"
                         VerticalContentAlignment="Center"
                         Foreground="LightGray"
                         Background="#33000000"
                         FontSize="16"
                         FontFamily="Segoe UI Semibold"
                         CaretBrush="LightSlateGray"
                         BorderBrush="SlateGray"
                         BorderThickness="0,0,0,0"
                         Margin="18,2,18,0"
                         Padding="5,2,5,2">
            </PasswordBox>
            
            <!-- Error message. -->
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}"
                        Foreground="IndianRed"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        TextWrapping="Wrap"
                        Margin="10,10,10,0"/>

            <!-- Submit button. Manually calls ViewModel command, necessary for PasswordBox security. -->
            <Button Name="ButtonSubmit"
                            Height="40"
                            Foreground="LightGray"
                            Content="SUBMIT"
                            FontSize="20"
                            Cursor="Hand"
                            Margin="40,10,40,0"
                            Click="ButtonSubmit_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4b4094"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="SlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a4cb5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Return to login interactable (clickable) text block. -->
            <TextBlock Name="CancelResetTextBlock"
                       Text="Cancel reset"
                       Background="Transparent"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       Margin="0,12,0,0"
                       MouseLeftButtonDown="CancelResetTextBlock_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LightSlateGray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
        </StackPanel>

    </Grid>

</UserControl>
