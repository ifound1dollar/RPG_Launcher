<UserControl x:Class="RPG_Launcher.View.Account.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.Account"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View.Account"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:AccountViewModel}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#7216141f" Offset="0"/>
                <GradientStop Color="#7216141f" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <StackPanel Orientation="Vertical"
                    Margin="250,0,250,0"
                    Grid.Row="0"
                    Background="#D026242f">

            <TextBlock Text="ACCOUNT SETTINGS"
                       Foreground="SlateGray"
                       FontSize="40"
                       FontFamily="Segoe UI"
                       TextAlignment="Center"
                       Margin="0,40,0,0"/>

            <TextBlock Text="Basic Info"
                       Foreground="LightGray"
                       FontSize="24"
                       FontFamily="Segoe UI"
                       TextAlignment="Left"
                       Margin="130,10,0,0"/>

            <StackPanel Name="UsernameRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="40"
                        Margin="120,5,120,0">
                <TextBlock Text="Username:"
                         Width="100"
                         Foreground="SlateGray"
                         Background="Transparent"
                         FontSize="20"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="15,0,0,2"/>
                <TextBlock Text="{Binding AccountUsername}"
                         Width="300"
                         Foreground="LightGray"
                         Background="Transparent"
                         FontSize="20"
                         FontFamily="Segoe UI Semibold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="25,0,0,2"/>
                <Button Name="ButtonChangeUsername"
                        Command="{Binding ChangeUsernameClickedCommand}"
                        Width="80"
                        Height="30"
                        Foreground="LightGray"
                        Content="CHANGE"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="15,0,0,0"
                    IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Name="EmailRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="40"
                        Margin="120,10,120,0">
                <TextBlock Text="Email:"
                         Width="100"
                         Foreground="SlateGray"
                         Background="Transparent"
                         FontSize="20"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="15,0,0,2"/>
                <TextBlock Text="{Binding AccountEmail}"
                         Width="300"
                         Foreground="LightGray"
                         Background="Transparent"
                         FontSize="20"
                         FontFamily="Segoe UI Semibold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="25,0,0,2"/>
                <Button Name="ButtonChangeEmail"
                        Command="{Binding ChangeEmailClickedCommand}"
                        Width="80"
                        Height="30"
                        Foreground="LightGray"
                        Content="CHANGE"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="15,0,0,0"
                        IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Name="PasswordRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="40"
                        Margin="120,10,120,0">
                <TextBlock Text="Password:"
                         Width="100"
                         Foreground="SlateGray"
                         Background="Transparent"
                         FontSize="20"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="15,0,0,2"/>
                <TextBlock Text="password not stored or displayed"
                         Width="300"
                         Foreground="DimGray"
                         Background="Transparent"
                         FontSize="20"
                         FontFamily="Segoe UI"
                         FontStyle="Italic"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="25,0,0,2"/>
                <Button Name="ButtonChangePassword"
                        Command="{Binding ChangePasswordClickedCommand}"
                        Width="80"
                        Height="30"
                        Foreground="LightGray"
                        Content="CHANGE"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="15,0,0,0"
                        IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock Text="Multi-Factor Authentication"
                       Foreground="LightGray"
                       FontSize="24"
                       FontFamily="Segoe UI"
                       TextAlignment="Left"
                       Margin="130,20,0,0"/>

            <TextBlock Text="Multi-factor authentication is required for all accounts and must be set up on account creation before it can be used. Manage the current MFA configuration here."
                       Foreground="LightBlue"
                       FontSize="14"
                       FontFamily="Segoe UI"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="120,5,120,0"/>

            <StackPanel Name="ManageMfaRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="50"
                        Margin="120,10,120,0">
                <Button Name="ButtonResetMfaConfiguration"
                        Command="{Binding ResetMfaConfigurationClickedCommand}"
                        Width="200"
                        Height="35"
                        Foreground="LightGray"
                        Content="Reset MFA Configuration"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="45,0,25,0"
                        IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button Name="ButtonRegenerateMfaRecoveryCode"
                        Command="{Binding RegenerateRecoveryCodeClickedCommand}"
                        Width="200"
                        Height="35"
                        Foreground="LightGray"
                        Content="Regenerate Recovery Code"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="25,0,30,0"
                        IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock Text="Account Recovery"
                       Foreground="LightGray"
                       FontSize="24"
                       FontFamily="Segoe UI"
                       TextAlignment="Left"
                       Margin="130,20,0,0"/>

            <StackPanel Name="SecondaryEmailRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="40"
                        Margin="120,5,120,0">
                <TextBlock Text="Secondary Email:"
                             Width="135"
                             Foreground="SlateGray"
                             Background="Transparent"
                             FontSize="18"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="15,0,0,2"/>
                <TextBlock Text="{Binding SecondaryEmail}"
                             Width="275"
                             Foreground="LightGray"
                             Background="Transparent"
                             FontSize="18"
                             FontFamily="Segoe UI"
                             FontStyle="Normal"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="15,0,0,2"/>
                <Button Name="ButtonChangeSecondaryEmail"
                        Command="{Binding ChangeSecondaryEmailClickedCommand}"
                        Width="80"
                        Height="30"
                        Foreground="LightGray"
                        Content="CHANGE"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="15,0,0,0"
                        IsEnabled="{Binding IsButtonInputEnabled}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Error message. -->
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}"
                        Foreground="IndianRed"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="200,15,200,0"/>

            <Button Name="ButtonLogout"
                    Command="{Binding LogoutClickedCommand}"
                    Height="40"
                    Foreground="LightGray"
                    Content="LOG OUT"
                    FontSize="20"
                    Cursor="Hand"
                    Margin="300,15,300,0"
                    IsEnabled="{Binding IsButtonInputEnabled}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ab3a3a"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="IndianRed"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#bc4b4b"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Name="CloseButton"
                    Command="{Binding CloseClickedCommand}"
                    Height="30"
                    Foreground="White"
                    Content="CLOSE SETTINGS"
                    FontSize="16"
                    Cursor="Hand"
                    Margin="320,20,320,0"
                    IsEnabled="{Binding IsButtonInputEnabled}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Gray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#ff909090"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
