<UserControl x:Class="RPG_Launcher.View.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.Account"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             KeyDown="Universal_KeyDown"
             d:DataContext="{d:DesignInstance Type=vm:ForgotPasswordViewModel}">
    <!-- DesignHeight is 690 and not 720 because we have a 30px header. -->

    <Grid Name="LoginSubgrid">

        <StackPanel Width="250px"
                    Orientation="Vertical"
                    Margin="0,120,0,130"
                    Grid.Row="1">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0016141f" Offset="-0.5"/>
                    <GradientStop Color="#D016141f" Offset="0.25"/>
                    <GradientStop Color="#DD16141f" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <Image Source="/Images/logo.png"
                   Width="64" Height="64"
                   Margin="0,25,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Title header. -->
            <TextBlock Text="Forgot Password"
                       Foreground="AliceBlue"
                       FontSize="20"
                       FontFamily="Segoe UI Semibold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
            
            <!-- Username/email header and text box. -->
            <TextBlock Text="Username or email"
                       Foreground="LightSlateGray"
                       FontSize="16"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Left"
                       Margin="12,50,0,0"/>
            <TextBox Name="TextBoxUsername"
                     Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Foreground="LightGray"
                     Background="#33000000"
                     FontSize="16"
                     FontFamily="Segoe UI Semibold"
                     CaretBrush="LightSlateGray"
                     BorderBrush="SlateGray"
                     BorderThickness="0,0,0,0"
                     Margin="10,2,10,0"
                     Padding="5,2,5,2"
                     GotKeyboardFocus="TextBox_GotKeyboardFocus"/>


            <!-- Error message. -->
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}"
                    Foreground="IndianRed"
                    FontSize="12"
                    FontFamily="Segoe UI"
                    TextWrapping="Wrap"
                    Margin="10,20,10,0"/>

            <!-- Submit button. Manually calls ViewModel command, necessary for PasswordBox security. -->
            <Button Name="ButtonSubmit"
                    Height="40"
                    Foreground="LightGray"
                    Content="SEND RESET CODE"
                    FontSize="16"
                    Cursor="Hand"
                    Margin="40,20,40,0"
                    Click="ButtonSubmit_Click"
                    IsEnabled="{Binding IsButtonInputEnabled}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4b4094"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="SlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a4cb5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bb444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Return to login interactable (clickable) text block. -->
            <TextBlock Name="ReturnToLoginTextBlock"
                       Text="Return to login"
                       Background="Transparent"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       Margin="0,12,0,0"
                       MouseLeftButtonDown="ReturnToLoginTextBlock_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LightSlateGray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
        </StackPanel>

    </Grid>
</UserControl>
