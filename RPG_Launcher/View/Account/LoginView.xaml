<UserControl x:Class="RPG_Launcher.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.Account"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             KeyDown="Universal_KeyDown"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">
    <!-- DesignHeight is 690 and not 720 because we have a 30px header. -->
    
    <Grid Name="LoginSubgrid">

        <StackPanel Width="250px"
                        Orientation="Vertical"
                        Margin="0,120,0,130"
                        Grid.Row="1">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0016141f" Offset="-0.5"/>
                    <GradientStop Color="#D016141f" Offset="0.25"/>
                    <GradientStop Color="#DD16141f" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <Image Source="/Images/logo.png"
                       Width="80" Height="80"
                       Margin="0,25,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="Log In"
                       Foreground="AliceBlue"
                       FontSize="20"
                       FontFamily="Segoe UI Semibold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
            
            <!-- Username header and text box. -->
            <TextBlock Text="Username or email"
                           Foreground="LightSlateGray"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Left"
                           Margin="12,15,0,0"/>
            <TextBox Name="TextBoxUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Foreground="LightGray"
                         Background="#33000000"
                         FontSize="16"
                         FontFamily="Segoe UI Semibold"
                         CaretBrush="LightSlateGray"
                         BorderBrush="SlateGray"
                         BorderThickness="0,0,0,0"
                         Margin="10,2,10,0"
                         Padding="5,2,5,2"/>

            <!-- Password header and text box. Breaks MVVM pattern for security. -->
            <TextBlock Text="Password"
                           Foreground="LightSlateGray"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Left"
                           Margin="12,10,0,0"/>
            <PasswordBox Name="TextBoxPassword"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Foreground="LightGray"
                                 Background="#33000000"
                                 FontSize="16"
                                 FontFamily="Segoe UI Semibold"
                                 CaretBrush="LightSlateGray"
                                 BorderBrush="SlateGray"
                                 BorderThickness="0,0,0,0"
                                 Margin="10,2,10,0"
                                 Padding="5,2,5,2"
                                 PasswordChanged="TextBoxPassword_PasswordChanged">
            </PasswordBox>

            <!-- Login error message. -->
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}"
                        Foreground="IndianRed"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        TextWrapping="Wrap"
                        Margin="10,10,10,0"/>

            <!-- Login button. Manually calls ViewModel command, necessary for PasswordBox security. -->
            <Button Name="ButtonLogin"
                    Height="40"
                    Foreground="LightGray"
                    Content="LOG IN"
                    FontSize="20"
                    Cursor="Hand"
                    Margin="40,10,40,0"
                    Click="ButtonLogin_Click"
                    IsEnabled="{Binding IsLoginButtonEnabled}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4b4094"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="SlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a4cb5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bb444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Forgot Password interactable (clickable) text block. -->
            <TextBlock Name="ForgotPasswordTextBlock"
                           Text="Forgot Password?"
                           Background="Transparent"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Cursor="Hand"
                           Margin="0,12,0,0"
                           MouseLeftButtonDown="ForgotPasswordTextBlock_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LightSlateGray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- New User / Register interactable (clickable) text block. -->
            <TextBlock Name="NewUserTextBlock"
               Text="Don't have an account? Register"
               Background="Transparent"
               FontFamily="Segoe UI"
               HorizontalAlignment="Center"
               Cursor="Hand"
               Margin="0,20,0,0"
               MouseLeftButtonDown="NewUserTextBlock_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LightSlateGray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

    </Grid>
</UserControl>
