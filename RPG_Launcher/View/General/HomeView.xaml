<UserControl x:Class="RPG_Launcher.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.General"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
    <!-- DesignHeight is 690 and not 720 because we have a 30px header. -->

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#7216141f" Offset="0"/>
                <GradientStop Color="#7216141f" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Name="SubHeaderBar" Height="75"/>
            <RowDefinition Name="Body" Height="615"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0">
            <Button Name="AccountSettings"
                    Command="{Binding AccountClickedCommand}"
                    Width="150"
                    Foreground="LightGray"
                    Content="ACCOUNT"
                    FontSize="20"
                    Cursor="Hand"
                    Margin="10,10,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4b4094"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="SlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a4cb5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bb444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

        <StackPanel Orientation="Vertical"
                    Grid.Row="1">
            <TextBlock Text="HOME SCREEN"
                        Foreground="GhostWhite"
                        FontSize="50"
                        FontFamily="Segoe UI"
                        TextAlignment="Center"
                        Margin="0,50,0,0"/>

            <!-- Error message. -->
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}"
                       Width="300"
                        Foreground="IndianRed"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        TextWrapping="Wrap"
                        Margin="0,200,0,0"/>

            <Button Name="PlayGameButton"
                    Focusable="False"
                    Command="{Binding PlayGameClickedCommand}"
                    Width="250"
                    Height="75"
                    Foreground="GhostWhite"
                    Content="PLAY GAME"
                    FontSize="32"
                    FontFamily="Segoe UI Black"
                    Cursor="Hand"
                    Margin="0,20,0,0"
                    IsEnabled="{Binding IsPlayGameButtonEnabled}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#ff029d02"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LimeGreen"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#ff16b116"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bb444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
        

    </Grid>
</UserControl>
