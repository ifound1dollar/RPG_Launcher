<UserControl x:Class="RPG_Launcher.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.General"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
    <!-- DesignHeight is 690 and not 720 because we have a 30px header. -->

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#7216141f" Offset="0"/>
                <GradientStop Color="#7216141f" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Name="SubHeaderBar" Height="75"/>
            <RowDefinition Name="Body" Height="615"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0">
            <Button Name="AccountSettings"
                    Command="{Binding AccountClickedCommand}"
                    Width="150"
                    Foreground="LightGray"
                    Background="DarkSlateBlue"
                    Content="ACCOUNT"
                    FontSize="20"
                    Cursor="Hand"
                    Margin="10,10,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

        <TextBlock Grid.Row="1"
                    Text="HOME SCREEN"
                    Foreground="GhostWhite"
                    FontSize="50"
                    FontFamily="Segoe UI"
                    TextAlignment="Center"
                    Margin="0,200,0,0"/>

    </Grid>
</UserControl>
