<UserControl x:Class="RPG_Launcher.View.EntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.General"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:EntryViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        
        <StackPanel Width="250px"
                    Orientation="Vertical"
                    Margin="0,240,0,250"
                    Grid.Row="1">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0016141f" Offset="-0.5"/>
                    <GradientStop Color="#D016141f" Offset="0.25"/>
                    <GradientStop Color="#DD16141f" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <!-- Status message. -->
            <TextBlock Text="{Binding StatusMessage, Mode=TwoWay}"
                       Foreground="{Binding MessageBrush, Mode=TwoWay}"
                       FontSize="18"
                       FontFamily="Segoe UI Semibold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="10,25,10,0"/>

            <!-- Return button. Manually calls ViewModel command, necessary for PasswordBox security. -->
            <Button Name="ButtonReturn"
                    Height="40"
                    Foreground="LightGray"
                    Content="RETRY"
                    FontSize="16"
                    Cursor="Hand"
                    Margin="60,25,60,0"
                    Click="ButtonRetry_Click"
                    Visibility="{Binding IsRetryButtonVisible, Converter={StaticResource BoolToVis}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4b4094"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="SlateBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5a4cb5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#bb444444"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>
</UserControl>
