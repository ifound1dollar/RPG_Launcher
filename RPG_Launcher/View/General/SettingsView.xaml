<UserControl x:Class="RPG_Launcher.View.General.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RPG_Launcher.ViewModel.General"
             xmlns:v="clr-namespace:RPG_Launcher.View"
             xmlns:local="clr-namespace:RPG_Launcher.View.General"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#7216141f" Offset="0"/>
                <GradientStop Color="#7216141f" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Orientation="Vertical"
            Margin="300,0,300,0"
            Grid.Row="0"
            Background="#D026242f">

            <TextBlock Text="APPLICATION SETTINGS"
                       Foreground="SlateGray"
                       FontSize="40"
                       FontFamily="Segoe UI"
                       TextAlignment="Center"
                       Margin="0,40,0,0"/>

            <TextBlock Text="Game installation directory:"
                       Foreground="LightGray"
                       FontSize="20"
                       FontFamily="Segoe UI"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       Margin="75,50,70,0"/>
            <StackPanel Name="PathToExecutableRow"
                        Orientation="Horizontal"
                        Background="#A016141f"
                        Height="40"
                        Margin="70,5,70,0">
                <TextBlock Text="{Binding GameDirectory}"
                             Width="420"
                             Foreground="LightGray"
                             Background="Transparent"
                             FontSize="14"
                             FontFamily="Segoe UI Semibold"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="15,0,0,2"/>
                <Button Name="ButtonChangeUsername"
                        Command="{Binding SetGameDirectoryClickedCommand}"
                        Width="80"
                        Height="30"
                        Foreground="LightGray"
                        Content="CHANGE"
                        FontSize="15"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Margin="15,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4b4094"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="SlateBlue"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5a4cb5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#bb444444"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Error message. -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Width="300"
                       Foreground="IndianRed"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="10,350,10,0"/>

            <Button Name="CloseButton"
                    Command="{Binding CloseButtonClickedCommand}"
                    Height="30"
                    Foreground="White"
                    Content="CLOSE SETTINGS"
                    FontSize="16"
                    Cursor="Hand"
                    Margin="270,15,270,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Gray"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#ff909090"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,2"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>

</UserControl>
